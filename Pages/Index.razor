@*
    首页 Dashboard：已登录时通过注入的 HttpClient（GenealogyApi + Cookie 转发）拉取 summary、族谱列表与族谱树预览。
    未登录时不调用受保护 API，避免 401 噪声。
*@
@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using GenealogyWeb.Controllers
@inject HttpClient Http
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<h3>Dashboard</h3>

<AuthorizeView>
    <Authorized Context="authState">
        <div class="alert alert-success mt-2">
            当前登录用户：<strong>@authState.User.Identity?.Name</strong>
            ，邮箱：<strong>@authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</strong>
            <span class="ms-2"><a href="/genealogies">进入族谱管理</a></span>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-secondary mt-2">
            未登录。请<a href="/login">登录</a>后查看与您相关的族谱与统计（示例数据绑定演示账号 demo@genealogy.local）。
        </div>
    </NotAuthorized>
</AuthorizeView>

<AuthorizeView>
    <Authorized>
        <div class="row mt-3">
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">族谱数量</h5>
                        <p class="display-6 mb-0">@summary?.GenealogyCount</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">成员总数</h5>
                        <p class="display-6 mb-0">@summary?.TotalMembers</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">男女比例</h5>
                        <p class="mb-1">男：@summary?.MaleCount (@summary?.MaleRatio%)</p>
                        <p class="mb-0">女：@summary?.FemaleCount (@summary?.FemaleRatio%)</p>
                    </div>
                </div>
            </div>
        </div>

        <p class="mt-2">登录后可查看您有权访问的族谱；演示环境可使用种子账号查看「张氏族谱」示例。</p>

        <div class="card shadow-sm mt-4">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <h5 class="card-title mb-1">族谱树预览</h5>
                        <p class="text-muted mb-0">选择族谱后即可查看对应的树形预览。</p>
                    </div>
                    <button class="btn btn-outline-primary btn-sm" @onclick="ReloadGenealogiesAsync" disabled="@_isLoadingGenealogies">
                        @(_isLoadingGenealogies ? "刷新中..." : "刷新族谱列表")
                    </button>
                </div>

                @if (_genealogyOptions.Count > 0)
                {
                    <div class="row g-3 align-items-end mb-3">
                        <div class="col-md-8">
                            <label class="form-label">选择族谱</label>
                            <InputSelect TValue="string" class="form-select" @bind-Value="_selectedGenealogyIdText" @bind-Value:after="LoadSelectedTreeAsync">
                                @foreach (var genealogy in _genealogyOptions)
                                {
                                    <option value="@genealogy.Id.ToString()">@genealogy.Title (@genealogy.Surname)</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <div class="text-muted small">当前选择：<strong>@GetSelectedGenealogyLabel()</strong></div>
                        </div>
                    </div>
                }

                @if (treeRoots is null)
                {
                    <div>正在加载族谱树...</div>
                }
                else if (!string.IsNullOrWhiteSpace(_treeError))
                {
                    <div class="alert alert-warning mb-0">@_treeError</div>
                }
                else if (treeRoots.Count == 0)
                {
                    <div>暂无可展示的族谱树。</div>
                }
                else
                {
                    <ul class="list-unstyled">
                        @foreach (var root in treeRoots)
                        {
                            <TreeNodeView Node="root" />
                        }
                    </ul>
                }
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="text-muted small mt-2">登录后将显示统计与族谱树。</div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<GenealogyDto> _genealogyOptions = new();
    private DashboardSummaryDto? summary;
    private List<TreeNodeDto>? treeRoots;
    private string? _selectedGenealogyIdText;
    private bool _isLoadingGenealogies;
    private string? _treeError;

    // 与 GET /api/genealogies 返回 JSON 对齐的轻量 DTO
    private record GenealogyDto(Guid Id, string Title, string Surname);

    // 与 GET /api/dashboard/summary 返回 JSON 对齐
    private record DashboardSummaryDto(int GenealogyCount, int TotalMembers, int MaleCount, int FemaleCount, double MaleRatio, double FemaleRatio);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated != true)
        {
            summary = null;
            _genealogyOptions = new List<GenealogyDto>();
            treeRoots = null;
            _selectedGenealogyIdText = null;
            _treeError = null;
            return;
        }

        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        summary = await Http.GetFromJsonAsync<DashboardSummaryDto>(new Uri(new Uri(Nav.BaseUri), "api/dashboard/summary"));
        await ReloadGenealogiesAsync();
    }

    private async Task ReloadGenealogiesAsync()
    {
        _isLoadingGenealogies = true;
        _treeError = null;

        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            if (auth.User.Identity?.IsAuthenticated != true)
            {
                _genealogyOptions = new List<GenealogyDto>();
                treeRoots = null;
                _selectedGenealogyIdText = null;
                return;
            }

            _genealogyOptions = await Http.GetFromJsonAsync<List<GenealogyDto>>(new Uri(new Uri(Nav.BaseUri), "api/genealogies")) ?? new List<GenealogyDto>();

            if (_genealogyOptions.Count == 0)
            {
                _selectedGenealogyIdText = null;
                treeRoots = new List<TreeNodeDto>();
                return;
            }

            if (string.IsNullOrWhiteSpace(_selectedGenealogyIdText) || !_genealogyOptions.Any(g => g.Id.ToString() == _selectedGenealogyIdText))
            {
                _selectedGenealogyIdText = _genealogyOptions[0].Id.ToString();
            }

            await LoadSelectedTreeAsync();
        }
        catch (Exception ex)
        {
            _genealogyOptions = new List<GenealogyDto>();
            treeRoots = new List<TreeNodeDto>();
            _selectedGenealogyIdText = null;
            _treeError = "加载族谱失败：" + ex.Message;
        }
        finally
        {
            _isLoadingGenealogies = false;
        }
    }

    private async Task LoadSelectedTreeAsync()
    {
        if (!Guid.TryParse(_selectedGenealogyIdText, out var genealogyId))
        {
            treeRoots = new List<TreeNodeDto>();
            return;
        }

        _treeError = null;

        try
        {
            treeRoots = await Http.GetFromJsonAsync<List<TreeNodeDto>>(
                new Uri(new Uri(Nav.BaseUri), $"api/genealogies/{genealogyId}/tree")) ?? new List<TreeNodeDto>();
        }
        catch (Exception ex)
        {
            treeRoots = new List<TreeNodeDto>();
            _treeError = "加载族谱树失败：" + ex.Message;
        }
    }

    private string GetSelectedGenealogyLabel()
    {
        if (!Guid.TryParse(_selectedGenealogyIdText, out var genealogyId))
        {
            return "未选择";
        }

        var genealogy = _genealogyOptions.FirstOrDefault(g => g.Id == genealogyId);
        return genealogy is null ? "未知族谱" : $"{genealogy.Title} ({genealogy.Surname})";
    }
}
