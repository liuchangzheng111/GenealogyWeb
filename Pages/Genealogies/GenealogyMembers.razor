@page "/genealogies/{GenealogyId:guid}/members"
@attribute [Authorize]
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@using Microsoft.JSInterop
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ToastService Toasts

<PageTitle>成员管理</PageTitle>

<h3 class="mb-2">成员管理</h3>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @_error
        <button type="button" class="btn-close" @onclick="() => _error = null" aria-label="关闭"></button>
    </div>
}

<div class="d-flex flex-wrap gap-2 mb-3">
    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="BackToDashboard">返回首页</button>
    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="BackToGenealogies">返回族谱列表</button>
    <a class="btn btn-outline-primary btn-sm" href="@($"/genealogies/{GenealogyId}")">族谱设置</a>
    <a class="btn btn-outline-primary btn-sm" href="@($"/genealogies/{GenealogyId}/relations")">关系查询</a>
</div>

@if (!_loaded)
{
    <div class="d-flex align-items-center gap-2 text-muted my-4">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>正在加载…</span>
    </div>
}
else if (!_canEdit)
{
    <div class="alert alert-info mb-0">
        您对本族谱为<strong>只读</strong>权限，无法在此页添加或修改成员。如需编辑，请联系族谱管理员将您设为「可编辑」。
    </div>
}

@if (_canEdit)
{
    <div class="d-flex align-items-center gap-2 mb-3">
        <button type="button" class="btn btn-primary" @onclick="() => ToggleAddForm(true)">添加成员</button>
        <input class="form-control form-control-sm w-auto" placeholder="搜索成员" @bind="_memberSearchQuery" />
        <button type="button" class="btn btn-sm btn-primary" @onclick="PerformMemberSearch">搜索</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClearMemberSearch">清空</button>
    </div>

    @if (_showAddForm)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title">@(_editingId is null ? "新增成员" : "编辑成员")</h5>
            <p class="text-muted small">配偶、父亲、母亲须为本族谱已有成员。<strong>新增</strong>时随成员一并创建关系；<strong>编辑</strong>时勾选「同步更新父母与配偶」后保存，将按当前选择重写（留空则清除对应关系）。</p>
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label">姓名 <span class="text-danger">*</span></label>
                    <input class="form-control" @bind="_formGivenName" placeholder="姓名" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">性别</label>
                    <select class="form-select" @bind="_formGender">
                        <option value="">未填</option>
                        <option value="男">男</option>
                        <option value="女">女</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">出生年</label>
                    <input type="number" class="form-control" @bind="_formBirthYear" placeholder="可选" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">去世年</label>
                    <input type="number" class="form-control" @bind="_formDeathYear" placeholder="可选" />
                </div>
                <div class="col-md-12 mt-2">
                    <label class="form-label">简介</label>
                    <textarea class="form-control" rows="2" @bind="_formBio" placeholder="生平简介（可选）"></textarea>
                </div>
                <div class="col-md-6 mt-2">
                    <label class="form-label">配偶</label>
                    @RenderCompactSearchBox("配偶", _spouseQuery, GetSpouseCandidates(), _formSpouseId, SetSpouseSelection, ClearSpouseSelection, SetSpouseOpen, _isSpouseOpen, SetSpouseQuery)
                </div>
                <div class="col-md-6 mt-2">
                    <label class="form-label">父亲</label>
                    @RenderCompactSearchBox("父亲", _fatherQuery, GetFatherCandidates(), _formFatherId, SetFatherSelection, ClearFatherSelection, SetFatherOpen, _isFatherOpen, SetFatherQuery)
                </div>
                <div class="col-md-6 mt-2">
                    <label class="form-label">母亲</label>
                    @RenderCompactSearchBox("母亲", _motherQuery, GetMotherCandidates(), _formMotherId, SetMotherSelection, ClearMotherSelection, SetMotherOpen, _isMotherOpen, SetMotherQuery)
                </div>
                @if (_editingId is not null)
                {
                    <div class="col-md-12 mt-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="sync-rel" @bind="_syncRelationshipsOnSave" />
                            <label class="form-check-label" for="sync-rel">同步更新父母与配偶（不勾选则只改姓名、性别、生卒年与简介）</label>
                        </div>
                    </div>
                }
            </div>
                <div class="mt-3">
                    @if (_editingId is null)
                    {
                        <button type="button" class="btn btn-primary" @onclick="CreatePersonAsync" disabled="@_busy">添加成员</button>
                        <button type="button" class="btn btn-secondary ms-2" @onclick="() => ToggleAddForm(false)">取消</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary me-2" @onclick="SavePersonAsync" disabled="@_busy">保存修改</button>
                        <button type="button" class="btn btn-secondary" @onclick="CancelEdit" disabled="@_busy">取消</button>
                    }
                </div>
            </div>
        </div>
    }
}

@if (_persons is null)
{
    <p class="text-muted small">加载成员列表…</p>
}
else if (_persons.Count == 0)
{
    <div class="alert alert-light border">暂无成员。请在上方表单添加第一位成员。</div>
}
else
{
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-sm table-bordered align-middle mb-0 bg-white">
            <thead class="table-light">
                <tr>
                    <th>姓名</th>
                    <th>性别</th>
                    <th>生卒年</th>
                    <th class="text-end">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in FilterMembers(_persons ?? new List<Person>(), _memberSearchFilter))
                {
                    <tr class="@(_editingId == p.Id ? "table-primary" : null)">
                        <td>@p.GivenName</td>
                        <td>@(p.Gender ?? "—")</td>
                        <td class="text-muted small">@FormatLife(p)</td>
                        <td class="text-end text-nowrap">
                            @if (_canEdit)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="async () => await StartEditAsync(p)">编辑</button>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeletePersonAsync(p.Id)">删除</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public Guid GenealogyId { get; set; }

    private List<Person>? _persons;
    private bool _loaded;
    private bool _canEdit;
    private string? _error;
    private bool _busy;
    private bool _showAddForm;
    private string _memberSearchQuery = "";
    private string _memberSearchFilter = "";

    private Guid? _editingId;
    private string _formGivenName = "";
    private string _formGender = "";
    private int? _formBirthYear;
    private int? _formDeathYear;
    private string _formBio = "";
    private string _formSpouseId = "";
    private string _formFatherId = "";
    private string _formMotherId = "";
    private string _spouseQuery = "";
    private string _fatherQuery = "";
    private string _motherQuery = "";
    private bool _isSpouseOpen;
    private bool _isFatherOpen;
    private bool _isMotherOpen;
    private bool _syncRelationshipsOnSave = true;

    protected override async Task OnParametersSetAsync()
    {
        _error = null;
        _editingId = null;
        ClearForm();
        await LoadRoleAndListAsync();
    }

    private static string FormatLife(Person p)
    {
        if (p.BirthYear.HasValue || p.DeathYear.HasValue)
        {
            return $"{p.BirthYear?.ToString() ?? "?"} — {p.DeathYear?.ToString() ?? "?"}";
        }

        return "—";
    }

    private async Task LoadRoleAndListAsync()
    {
        _loaded = false;
        try
        {
            var baseUri = new Uri(Nav.BaseUri);
            var meResp = await Http.GetAsync(new Uri(baseUri, $"api/genealogies/{GenealogyId}/me"));
            if (!meResp.IsSuccessStatusCode)
            {
                _error = await ApiUiMessage.FormatAsync(meResp);
                _persons = new List<Person>();
                _canEdit = false;
                return;
            }

            var me = await meResp.Content.ReadFromJsonAsync<MeMembershipDto>(ApiUiMessage.JsonReadOptions);
            var role = me?.Role;
            _canEdit = string.Equals(role, "Owner", StringComparison.OrdinalIgnoreCase)
                || string.Equals(role, "Editor", StringComparison.OrdinalIgnoreCase);

            var listResp = await Http.GetAsync(new Uri(baseUri, $"api/persons/byGenealogy/{GenealogyId}"));
            if (!listResp.IsSuccessStatusCode)
            {
                _error = await ApiUiMessage.FormatAsync(listResp);
                _persons = new List<Person>();
                return;
            }

            _persons = await listResp.Content.ReadFromJsonAsync<List<Person>>(ApiUiMessage.JsonReadOptions) ?? new List<Person>();
        }
        catch (Exception ex)
        {
            _error = "加载失败：" + ex.Message;
            _persons = new List<Person>();
            _canEdit = false;
        }
        finally
        {
            _loaded = true;
        }
    }

    private void ClearForm()
    {
        _formGivenName = "";
        _formGender = "";
        _formBirthYear = null;
        _formDeathYear = null;
        _formBio = "";
        _formSpouseId = "";
        _formFatherId = "";
        _formMotherId = "";
        _spouseQuery = "";
        _fatherQuery = "";
        _motherQuery = "";
        _isSpouseOpen = false;
        _isFatherOpen = false;
        _isMotherOpen = false;
        _syncRelationshipsOnSave = true;
    }

    private async Task StartEditAsync(Person p)
    {
        _showAddForm = true;
        _editingId = p.Id;
        _formGivenName = p.GivenName;
        _formGender = p.Gender ?? "";
        _formBirthYear = p.BirthYear;
        _formDeathYear = p.DeathYear;
        _formBio = p.Bio ?? "";
        _syncRelationshipsOnSave = true;
        ClearRelationSelectionsOnly();

        var baseUri = new Uri(Nav.BaseUri);
        try
        {
            var resp = await Http.GetAsync(new Uri(baseUri, $"api/persons/{p.Id}/family"));
            if (!resp.IsSuccessStatusCode)
            {
                return;
            }

            var fam = await resp.Content.ReadFromJsonAsync<PersonFamilyJson>(ApiUiMessage.JsonReadOptions);
            if (fam?.FatherId is { } fid)
            {
                _formFatherId = fid.ToString();
                if (TryFindPerson(_persons ?? Enumerable.Empty<Person>(), fid.ToString(), out var fp))
                {
                    _fatherQuery = fp!.GivenName;
                }
            }

            if (fam?.MotherId is { } mid)
            {
                _formMotherId = mid.ToString();
                if (TryFindPerson(_persons ?? Enumerable.Empty<Person>(), mid.ToString(), out var mp))
                {
                    _motherQuery = mp!.GivenName;
                }
            }

            if (fam?.SpouseId is { } sid)
            {
                _formSpouseId = sid.ToString();
                if (TryFindPerson(_persons ?? Enumerable.Empty<Person>(), sid.ToString(), out var sp))
                {
                    _spouseQuery = sp!.GivenName;
                }
            }
        }
        catch
        {
            // 保持空关系即可
        }
    }

    private void ClearRelationSelectionsOnly()
    {
        _formSpouseId = "";
        _formFatherId = "";
        _formMotherId = "";
        _spouseQuery = "";
        _fatherQuery = "";
        _motherQuery = "";
    }

    private IEnumerable<Person> GetSpouseCandidates() => GetParentCandidates();

    private IEnumerable<Person> GetFatherCandidates()
        => GetParentCandidates().Where(p => IsMale(p.Gender));

    private IEnumerable<Person> GetMotherCandidates()
        => GetParentCandidates().Where(p => IsFemale(p.Gender));

    private IEnumerable<Person> GetParentCandidates()
        => (_persons ?? Enumerable.Empty<Person>())
            .Where(p => p.GenealogyId == GenealogyId && (!_editingId.HasValue || p.Id != _editingId.Value))
            .OrderBy(p => p.BirthYear ?? int.MaxValue)
            .ThenBy(p => p.GivenName);

    private static bool IsMale(string? gender)
        => !string.IsNullOrWhiteSpace(gender) && (
            string.Equals(gender, "男", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(gender, "m", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(gender, "male", StringComparison.OrdinalIgnoreCase));

    private static bool IsFemale(string? gender)
        => !string.IsNullOrWhiteSpace(gender) && (
            string.Equals(gender, "女", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(gender, "f", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(gender, "female", StringComparison.OrdinalIgnoreCase));

    private static string FormatPersonLabel(Person person)
    {
        var life = person.BirthYear.HasValue || person.DeathYear.HasValue
            ? $" ({person.BirthYear?.ToString() ?? "?"}—{person.DeathYear?.ToString() ?? "?"})"
            : string.Empty;

        return $"{person.GivenName}{life}";
    }

    private RenderFragment RenderCompactSearchBox(
        string label,
        string query,
        IEnumerable<Person> source,
        string selectedId,
        Action<Person> onSelect,
        Action onClear,
        Action<bool> onToggle,
        bool isOpen,
        Action<string> onQueryChange) => builder =>
    {
        var matches = FilterCandidates(source, query).ToList();
        var sequence = 0;

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "border rounded p-2 bg-light");
        builder.AddAttribute(sequence++, "style", "min-height: 4.5rem;");

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "d-flex justify-content-between align-items-center gap-2");

        builder.OpenElement(sequence++, "strong");
        builder.AddContent(sequence++, label);
        builder.CloseElement();

        builder.OpenElement(sequence++, "button");
        builder.AddAttribute(sequence++, "type", "button");
        builder.AddAttribute(sequence++, "class", "btn btn-sm btn-outline-primary");
        builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, () => onToggle(!isOpen)));
        builder.AddContent(sequence++, isOpen ? "收起" : "展开搜索");
        builder.CloseElement();

        builder.CloseElement();

        if (!string.IsNullOrWhiteSpace(selectedId) && TryFindPerson(source, selectedId, out var selectedPerson) && selectedPerson is not null)
        {
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "text-muted small mt-1");
            builder.AddContent(sequence++, $"已选择：{FormatPersonLabel(selectedPerson)}");
            builder.CloseElement();
        }

        if (isOpen)
        {
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "mt-2");

            builder.OpenElement(sequence++, "input");
            builder.AddAttribute(sequence++, "class", "form-control");
            builder.AddAttribute(sequence++, "placeholder", "输入姓名模糊搜索");
            builder.AddAttribute(sequence++, "value", query);
            builder.AddAttribute(sequence++, "oninput", EventCallback.Factory.CreateBinder<string>(this, onQueryChange, query));
            builder.CloseElement();

            if (!string.IsNullOrWhiteSpace(query) && matches.Count == 0)
            {
                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "text-muted small mt-2");
                builder.AddContent(sequence++, "族谱没有匹配成员");
                builder.CloseElement();
            }

            if (!string.IsNullOrWhiteSpace(selectedId) && TryFindPerson(source, selectedId, out var selectedAgain) && selectedAgain is not null)
            {
                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "d-flex align-items-center gap-2 mt-2 mb-2");
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "badge bg-success");
                builder.AddContent(sequence++, $"已选：{FormatPersonLabel(selectedAgain)}");
                builder.CloseElement();
                builder.OpenElement(sequence++, "button");
                builder.AddAttribute(sequence++, "type", "button");
                builder.AddAttribute(sequence++, "class", "btn btn-sm btn-outline-secondary");
                builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, onClear));
                builder.AddContent(sequence++, "清空");
                builder.CloseElement();
                builder.CloseElement();
            }

            if (matches.Count > 0)
            {
                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "list-group mb-2");

                foreach (var person in matches.Take(8))
                {
                    builder.OpenElement(sequence++, "button");
                    builder.AddAttribute(sequence++, "type", "button");
                    builder.AddAttribute(sequence++, "class", "list-group-item list-group-item-action d-flex justify-content-between align-items-center");
                    builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, () => onSelect(person)));
                    builder.AddContent(sequence++, FormatPersonLabel(person));
                    builder.CloseElement();
                }

                builder.CloseElement();
            }

            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private void SetSpouseQuery(string value) => _spouseQuery = value;
    private void SetFatherQuery(string value) => _fatherQuery = value;
    private void SetMotherQuery(string value) => _motherQuery = value;

    private void SetSpouseOpen(bool isOpen) => _isSpouseOpen = isOpen;
    private void SetFatherOpen(bool isOpen) => _isFatherOpen = isOpen;
    private void SetMotherOpen(bool isOpen) => _isMotherOpen = isOpen;

    private static IEnumerable<Person> FilterCandidates(IEnumerable<Person> source, string query)
    {
        var list = source.ToList();
        if (string.IsNullOrWhiteSpace(query))
        {
            return list;
        }

        return list.Where(p => p.GivenName.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase));
    }

    private static bool TryFindPerson(IEnumerable<Person> source, string idText, out Person? person)
    {
        person = null;
        if (!Guid.TryParse(idText, out var gid))
        {
            return false;
        }

        person = source.FirstOrDefault(p => p.Id == gid);
        return person != null;
    }

    private void SetSpouseSelection(Person person)
    {
        _formSpouseId = person.Id.ToString();
        _spouseQuery = person.GivenName;
    }

    private void ClearSpouseSelection()
    {
        _formSpouseId = "";
        _spouseQuery = "";
    }

    private void SetFatherSelection(Person person)
    {
        _formFatherId = person.Id.ToString();
        _fatherQuery = person.GivenName;
    }

    private void ClearFatherSelection()
    {
        _formFatherId = "";
        _fatherQuery = "";
    }

    private void SetMotherSelection(Person person)
    {
        _formMotherId = person.Id.ToString();
        _motherQuery = person.GivenName;
    }

    private void ClearMotherSelection()
    {
        _formMotherId = "";
        _motherQuery = "";
    }

    private void BackToDashboard() => Nav.NavigateTo("/");

    private void BackToGenealogies() => Nav.NavigateTo("/genealogies");

    private void CancelEdit()
    {
        _editingId = null;
        ClearForm();
        _showAddForm = false;
    }

    private void ToggleAddForm(bool open)
    {
        _showAddForm = open;
        if (!open)
        {
            _editingId = null;
            ClearForm();
        }
    }

    private void ClearMemberSearch()
    {
        _memberSearchQuery = string.Empty;
        _memberSearchFilter = string.Empty;
    }

    private static IEnumerable<Person> FilterMembers(IEnumerable<Person> source, string query)
    {
        var list = source.ToList();
        if (string.IsNullOrWhiteSpace(query)) return list;
        var q = query.Trim();
        return list.Where(p => p.GivenName.Contains(q, StringComparison.OrdinalIgnoreCase));
    }

    private void PerformMemberSearch()
    {
        _memberSearchFilter = _memberSearchQuery?.Trim() ?? string.Empty;
    }

    private async Task CreatePersonAsync()
    {
        if (_busy || !_canEdit) return;
        if (string.IsNullOrWhiteSpace(_formGivenName))
        {
            _error = "请填写姓名。";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var request = new CreatePersonDto(
                GenealogyId,
                _formGivenName.Trim(),
                string.IsNullOrWhiteSpace(_formGender) ? null : _formGender.Trim(),
                _formBirthYear,
                _formDeathYear,
                string.IsNullOrWhiteSpace(_formBio) ? null : _formBio.Trim(),
                Guid.TryParse(_formSpouseId, out var spouseId) ? spouseId : null,
                Guid.TryParse(_formFatherId, out var fatherId) ? fatherId : null,
                Guid.TryParse(_formMotherId, out var motherId) ? motherId : null);

            var resp = await Http.PostAsJsonAsync(new Uri(new Uri(Nav.BaseUri), "api/persons"), request);
            if (!resp.IsSuccessStatusCode)
            {
                _error = await ApiUiMessage.FormatAsync(resp);
                return;
            }

            Toasts.ShowSuccess("已添加成员。");
            ClearForm();
            await LoadRoleAndListAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SavePersonAsync()
    {
        if (_busy || !_canEdit || _editingId is null) return;
        if (string.IsNullOrWhiteSpace(_formGivenName))
        {
            _error = "请填写姓名。";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var dto = new UpdatePersonDto(
                _formGivenName.Trim(),
                string.IsNullOrWhiteSpace(_formGender) ? null : _formGender.Trim(),
                _formBirthYear,
                _formDeathYear,
                string.IsNullOrWhiteSpace(_formBio) ? null : _formBio.Trim(),
                _syncRelationshipsOnSave,
                Guid.TryParse(_formFatherId, out var ef) ? ef : null,
                Guid.TryParse(_formMotherId, out var em) ? em : null,
                Guid.TryParse(_formSpouseId, out var es) ? es : null);

            var resp = await Http.PutAsJsonAsync(
                new Uri(new Uri(Nav.BaseUri), $"api/persons/{_editingId.Value}"),
                dto);

            if (!resp.IsSuccessStatusCode)
            {
                _error = await ApiUiMessage.FormatAsync(resp);
                return;
            }

            Toasts.ShowSuccess("已保存。");
            CancelEdit();
            await LoadRoleAndListAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeletePersonAsync(Guid id)
    {
        if (_busy || !_canEdit) return;
        var ok = await JS.InvokeAsync<bool>("confirm", "确定删除该成员？与其相关父母子女、婚姻记录将一并删除，且不可恢复。");
        if (!ok)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var resp = await Http.DeleteAsync(new Uri(new Uri(Nav.BaseUri), $"api/persons/{id}"));
            if (!resp.IsSuccessStatusCode)
            {
                _error = await ApiUiMessage.FormatAsync(resp);
                return;
            }

            Toasts.ShowSuccess("已删除。");
            if (_editingId == id)
            {
                CancelEdit();
            }

            await LoadRoleAndListAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class MeMembershipDto
    {
        [JsonPropertyName("role")]
        public string? Role { get; set; }
    }

    private sealed class PersonFamilyJson
    {
        [JsonPropertyName("fatherId")]
        public Guid? FatherId { get; set; }

        [JsonPropertyName("motherId")]
        public Guid? MotherId { get; set; }

        [JsonPropertyName("spouseId")]
        public Guid? SpouseId { get; set; }
    }
}
