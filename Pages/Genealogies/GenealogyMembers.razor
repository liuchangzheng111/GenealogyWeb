@page "/genealogies/{GenealogyId:guid}/members"
@inject HttpClient Http
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<h3>成员管理</h3>

<AuthorizeView>
    <NotAuthorized>
        <div class="alert alert-warning">请先<a href="/login">登录</a>。</div>
    </NotAuthorized>
    <Authorized>
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }
        @if (!string.IsNullOrEmpty(_info))
        {
            <div class="alert alert-success">@_info</div>
        }

        <p class="text-muted mb-3">
            <a href="/genealogies">← 族谱列表</a>
            ·
            <a href="@($"/genealogies/{GenealogyId}")">族谱设置</a>
        </p>

        @if (!_loaded)
        {
            <p>加载中…</p>
        }
        else if (!_canEdit)
        {
            <div class="alert alert-info">您对本族谱为只读（Viewer），无法增删改成员。</div>
        }

        @if (_canEdit)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title">@( _editingId is null ? "新增成员" : "编辑成员")</h5>
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label">姓名</label>
                            <input class="form-control" @bind="_formGivenName" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">性别</label>
                            <input class="form-control" @bind="_formGender" placeholder="男/女" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">出生年</label>
                            <input type="number" class="form-control" @bind="_formBirthYear" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">去世年</label>
                            <input type="number" class="form-control" @bind="_formDeathYear" />
                        </div>
                        <div class="col-md-12 mt-2">
                            <label class="form-label">简介</label>
                            <textarea class="form-control" rows="2" @bind="_formBio"></textarea>
                        </div>
                    </div>
                    <div class="mt-3">
                        @if (_editingId is null)
                        {
                            <button type="button" class="btn btn-primary" @onclick="CreatePersonAsync" disabled="@_busy">添加</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-primary me-2" @onclick="SavePersonAsync" disabled="@_busy">保存修改</button>
                            <button type="button" class="btn btn-secondary" @onclick="CancelEdit" disabled="@_busy">取消</button>
                        }
                    </div>
                </div>
            </div>
        }

        @if (_persons is null)
        {
            <p>加载成员列表…</p>
        }
        else if (_persons.Count == 0)
        {
            <p class="text-muted">暂无成员。</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>姓名</th>
                            <th>性别</th>
                            <th>生卒</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _persons)
                        {
                            <tr class="@(_editingId == p.Id ? "table-primary" : "")">
                                <td>@p.GivenName</td>
                                <td>@(p.Gender ?? "—")</td>
                                <td>@FormatLife(p)</td>
                                <td>
                                    @if (_canEdit)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="() => StartEdit(p)">编辑</button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeletePersonAsync(p.Id)">删除</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
    [Parameter] public Guid GenealogyId { get; set; }

    private List<Person>? _persons;
    private bool _loaded;
    private bool _canEdit;
    private string? _error;
    private string? _info;
    private bool _busy;

    private Guid? _editingId;
    private string _formGivenName = "";
    private string _formGender = "";
    private int? _formBirthYear;
    private int? _formDeathYear;
    private string _formBio = "";

    protected override async Task OnParametersSetAsync()
    {
        _error = null;
        _info = null;
        _editingId = null;
        ClearForm();

        var auth = await AuthState.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        await LoadRoleAndListAsync();
    }

    private static string FormatLife(Person p)
    {
        if (p.BirthYear.HasValue || p.DeathYear.HasValue)
        {
            return $"{p.BirthYear?.ToString() ?? "?"} — {p.DeathYear?.ToString() ?? "?"}";
        }

        return "—";
    }

    private async Task LoadRoleAndListAsync()
    {
        _loaded = false;
        try
        {
            var baseUri = new Uri(Nav.BaseUri);
            var me = await Http.GetFromJsonAsync<MeMembershipDto>(new Uri(baseUri, $"api/genealogies/{GenealogyId}/me"));
            var role = me?.Role;
            _canEdit = string.Equals(role, "Owner", StringComparison.OrdinalIgnoreCase)
                || string.Equals(role, "Editor", StringComparison.OrdinalIgnoreCase);

            _persons = await Http.GetFromJsonAsync<List<Person>>(new Uri(baseUri, $"api/persons/byGenealogy/{GenealogyId}"));
        }
        catch (Exception ex)
        {
            _error = "加载失败：" + ex.Message;
            _persons = new List<Person>();
            _canEdit = false;
        }
        finally
        {
            _loaded = true;
        }
    }

    private void ClearForm()
    {
        _formGivenName = "";
        _formGender = "";
        _formBirthYear = null;
        _formDeathYear = null;
        _formBio = "";
    }

    private void StartEdit(Person p)
    {
        _editingId = p.Id;
        _formGivenName = p.GivenName;
        _formGender = p.Gender ?? "";
        _formBirthYear = p.BirthYear;
        _formDeathYear = p.DeathYear;
        _formBio = p.Bio ?? "";
    }

    private void CancelEdit()
    {
        _editingId = null;
        ClearForm();
    }

    private async Task CreatePersonAsync()
    {
        if (_busy || !_canEdit) return;
        _busy = true;
        _error = null;
        _info = null;
        try
        {
            var model = new Person
            {
                GenealogyId = GenealogyId,
                GivenName = _formGivenName.Trim(),
                Gender = string.IsNullOrWhiteSpace(_formGender) ? null : _formGender.Trim(),
                BirthYear = _formBirthYear,
                DeathYear = _formDeathYear,
                Bio = string.IsNullOrWhiteSpace(_formBio) ? null : _formBio.Trim()
            };

            var resp = await Http.PostAsJsonAsync(new Uri(new Uri(Nav.BaseUri), "api/persons"), model);
            if (!resp.IsSuccessStatusCode)
            {
                _error = await resp.Content.ReadAsStringAsync();
                return;
            }

            _info = "已添加成员。";
            ClearForm();
            await LoadRoleAndListAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SavePersonAsync()
    {
        if (_busy || !_canEdit || _editingId is null) return;
        _busy = true;
        _error = null;
        _info = null;
        try
        {
            var dto = new UpdatePersonDto(
                _formGivenName.Trim(),
                string.IsNullOrWhiteSpace(_formGender) ? null : _formGender.Trim(),
                _formBirthYear,
                _formDeathYear,
                string.IsNullOrWhiteSpace(_formBio) ? null : _formBio.Trim());

            var resp = await Http.PutAsJsonAsync(
                new Uri(new Uri(Nav.BaseUri), $"api/persons/{_editingId.Value}"),
                dto);

            if (!resp.IsSuccessStatusCode)
            {
                _error = await resp.Content.ReadAsStringAsync();
                return;
            }

            _info = "已保存。";
            CancelEdit();
            await LoadRoleAndListAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeletePersonAsync(Guid id)
    {
        if (_busy || !_canEdit) return;
        _busy = true;
        _error = null;
        _info = null;
        try
        {
            var resp = await Http.DeleteAsync(new Uri(new Uri(Nav.BaseUri), $"api/persons/{id}"));
            if (!resp.IsSuccessStatusCode)
            {
                _error = await resp.Content.ReadAsStringAsync();
                return;
            }

            _info = "已删除。";
            if (_editingId == id)
            {
                CancelEdit();
            }

            await LoadRoleAndListAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class MeMembershipDto
    {
        [System.Text.Json.Serialization.JsonPropertyName("role")]
        public string? Role { get; set; }
    }
}
