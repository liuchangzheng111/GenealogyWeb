@page "/genealogies/{GenealogyId:guid}"
@attribute [Authorize]
@using System.Net.Http.Json
@using Microsoft.JSInterop
@inject HttpClient Http
@inject NavigationManager Nav
@inject ToastService Toasts
@inject IJSRuntime JS

<PageTitle>族谱设置</PageTitle>

<h3 class="mb-2">族谱设置</h3>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @_error
        <button type="button" class="btn-close" @onclick="() => _error = null" aria-label="关闭"></button>
    </div>
}

@if (_genealogy is null && string.IsNullOrEmpty(_error))
{
    <div class="d-flex align-items-center gap-2 text-muted my-4">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>正在加载…</span>
    </div>
}
else if (_genealogy is null)
{
    <p class="text-muted">无法加载该族谱，请从<a href="/genealogies">族谱列表</a>重新进入。</p>
}
else
{
    <div class="d-flex flex-wrap gap-2 mb-3">
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="BackToGenealogies">返回族谱列表</button>
        <a class="btn btn-outline-primary btn-sm" href="@($"/genealogies/{GenealogyId}/members")">成员管理</a>
        <a class="btn btn-outline-primary btn-sm" href="@($"/genealogies/{GenealogyId}/relations")">关系查询</a>
    </div>

    @if (!string.IsNullOrEmpty(_myRole))
    {
        <div class="alert alert-light border mb-4 py-2 small" role="status">
            您在本族谱中的权限：<strong>@RoleUiText.ToChinese(_myRole)</strong>
            @if (!_canEdit)
            {
                <span class="text-muted">（无法修改族谱信息或成员）</span>
            }
        </div>
    }

    @if (_canEdit)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title">编辑信息</h5>
                <p class="text-muted small">修改谱名、姓氏或修谱时间；保存后立即生效。</p>
                <div class="mb-2">
                    <label class="form-label">谱名</label>
                    <input class="form-control" @bind="_editTitle" />
                </div>
                <div class="mb-2">
                    <label class="form-label">姓氏</label>
                    <input class="form-control" @bind="_editSurname" />
                </div>
                <div class="mb-3">
                    <label class="form-label">修谱时间</label>
                    <input type="datetime-local" class="form-control" @bind="_editCompiledLocal" />
                    <div class="form-text">留空表示未填写；按本地时间选择，保存时转为 UTC 存库。</div>
                </div>
                <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@_busy">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                    }
                    保存
                </button>
            </div>
        </div>
    }

    @if (_canManage)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title">邀请协作者</h5>
                <p class="text-muted small mb-3">对方须<strong>已注册</strong>；通过邮箱匹配用户。被邀请人登录后即可在列表中看到本族谱。</p>
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label">对方邮箱</label>
                        <input class="form-control" type="email" @bind="_inviteEmail" placeholder="friend@example.com" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">权限</label>
                        <select class="form-select" @bind="_inviteRole">
                            <option value="Editor">可编辑成员与关系</option>
                            <option value="Viewer">仅查看</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="button" class="btn btn-outline-primary w-100" @onclick="InviteAsync" disabled="@_busy">发送邀请</button>
                    </div>
                </div>
            </div>
        </div>

        @if (_confirmDelete)
        {
            <div class="alert alert-warning">
                <p class="mb-2"><strong>确定删除整个族谱？</strong>将同时删除所有成员、父母子女、婚姻与协作记录，且不可恢复。</p>
                <button type="button" class="btn btn-danger me-2" @onclick="DeleteConfirmedAsync" disabled="@_busy">确认删除</button>
                <button type="button" class="btn btn-secondary" @onclick="() => _confirmDelete = false">取消</button>
            </div>
        }
        else
        {
            <button type="button" class="btn btn-outline-danger mb-4" @onclick="() => _confirmDelete = true">删除整本族谱</button>
        }
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title">协作成员</h5>
            @if (_collaborators is null)
            {
                <div class="text-muted small">加载中…</div>
            }
            else if (_collaborators.Count == 0)
            {
                <p class="text-muted small mb-0">暂无协作记录（若您为创建者且未写入协作表，界面仍可能显示为管理员权限）。</p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var c in _collaborators)
                    {
                        var isCreator = _genealogy!.CreatedByUserId == c.UserId;
                        var isRoleOwner = string.Equals(c.Role, "Owner", StringComparison.OrdinalIgnoreCase);
                        <li class="list-group-item d-flex flex-wrap justify-content-between gap-2 align-items-center">
                            <div>
                                <span>@c.UserName <span class="text-muted">&lt;@c.Email&gt;</span></span>
                                @if (isCreator)
                                {
                                    <span class="badge bg-primary ms-1">谱主</span>
                                }
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                @if (_canManage && !isCreator && !isRoleOwner)
                                {
                                    <select class="form-select form-select-sm" style="width: 9rem" value="@c.Role" @onchange="e => PatchCollaboratorRoleAsync(c.UserId, e.Value?.ToString())" disabled="@_busy">
                                        <option value="Editor">可编辑</option>
                                        <option value="Viewer">仅查看</option>
                                    </select>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveCollaboratorAsync(c.UserId)" disabled="@_busy">移除</button>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@RoleUiText.ToChinese(c.Role)</span>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}

@code {
    [Parameter] public Guid GenealogyId { get; set; }

    private Genealogy? _genealogy;
    private List<GenealogyCollaboratorDto>? _collaborators;
    private string? _error;
    private bool _busy;
    private bool _canEdit;
    private bool _canManage;
    private bool _confirmDelete;
    private string? _myRole;

    private string _editTitle = "";
    private string _editSurname = "";
    private DateTime? _editCompiledLocal;

    private string _inviteEmail = "";
    private string _inviteRole = "Editor";

    protected override async Task OnParametersSetAsync()
    {
        _error = null;
        _confirmDelete = false;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _genealogy = null;
        _collaborators = null;
        _myRole = null;
        try
        {
            var baseUri = new Uri(Nav.BaseUri);

            var gResp = await Http.GetAsync(new Uri(baseUri, $"api/genealogies/{GenealogyId}"));
            if (!gResp.IsSuccessStatusCode)
            {
                _error = await ApiUiMessage.FormatAsync(gResp);
                return;
            }

            _genealogy = await gResp.Content.ReadFromJsonAsync<Genealogy>(ApiUiMessage.JsonReadOptions);
            if (_genealogy == null)
            {
                _error = "族谱不存在。";
                return;
            }

            _editTitle = _genealogy.Title;
            _editSurname = _genealogy.Surname;
            _editCompiledLocal = _genealogy.CompiledAt?.ToLocalTime();

            var meResp = await Http.GetAsync(new Uri(baseUri, $"api/genealogies/{GenealogyId}/me"));
            if (!meResp.IsSuccessStatusCode)
            {
                _error = await ApiUiMessage.FormatAsync(meResp);
                return;
            }

            var me = await meResp.Content.ReadFromJsonAsync<MeMembershipDto>(ApiUiMessage.JsonReadOptions);
            _myRole = me?.Role;
            _canManage = string.Equals(_myRole, "Owner", StringComparison.OrdinalIgnoreCase);
            _canEdit = _canManage || string.Equals(_myRole, "Editor", StringComparison.OrdinalIgnoreCase);

            var colResp = await Http.GetAsync(new Uri(baseUri, $"api/genealogies/{GenealogyId}/collaborators"));
            if (!colResp.IsSuccessStatusCode)
            {
                _error = await ApiUiMessage.FormatAsync(colResp);
                _collaborators = new List<GenealogyCollaboratorDto>();
                return;
            }

            _collaborators = await colResp.Content.ReadFromJsonAsync<List<GenealogyCollaboratorDto>>(ApiUiMessage.JsonReadOptions)
                ?? new List<GenealogyCollaboratorDto>();
        }
        catch (Exception ex)
        {
            _error = "加载失败：" + ex.Message;
        }
    }

    private async Task SaveAsync()
    {
        if (_busy || !_canEdit) return;
        _busy = true;
        _error = null;
        try
        {
            DateTime? utc = _editCompiledLocal.HasValue
                ? DateTime.SpecifyKind(_editCompiledLocal.Value, DateTimeKind.Local).ToUniversalTime()
                : null;

            var resp = await Http.PutAsJsonAsync(
                new Uri(new Uri(Nav.BaseUri), $"api/genealogies/{GenealogyId}"),
                new UpdateGenealogyDto(_editTitle.Trim(), _editSurname.Trim(), utc));

            if (!resp.IsSuccessStatusCode)
            {
                _error = await ApiUiMessage.FormatAsync(resp);
                return;
            }

            Toasts.ShowSuccess("已保存。");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task InviteAsync()
    {
        if (_busy || !_canManage) return;
        if (string.IsNullOrWhiteSpace(_inviteEmail))
        {
            _error = "请填写对方邮箱。";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var resp = await Http.PostAsJsonAsync(
                new Uri(new Uri(Nav.BaseUri), $"api/genealogies/{GenealogyId}/invite"),
                new InviteGenealogyDto(_inviteEmail.Trim(), _inviteRole));

            if (!resp.IsSuccessStatusCode)
            {
                _error = await ApiUiMessage.FormatAsync(resp);
                return;
            }

            _inviteEmail = "";
            Toasts.ShowSuccess("邀请已发送，对方登录后即可看到本族谱。");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteConfirmedAsync()
    {
        if (_busy || !_canManage) return;
        _busy = true;
        _error = null;
        try
        {
            var resp = await Http.DeleteAsync(new Uri(new Uri(Nav.BaseUri), $"api/genealogies/{GenealogyId}"));
            if (!resp.IsSuccessStatusCode)
            {
                _error = await ApiUiMessage.FormatAsync(resp);
                _confirmDelete = false;
                return;
            }

            Nav.NavigateTo("/genealogies", forceLoad: true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _confirmDelete = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PatchCollaboratorRoleAsync(Guid userId, string? newRole)
    {
        if (_busy || !_canManage || string.IsNullOrWhiteSpace(newRole)) return;
        if (string.Equals(newRole, "Owner", StringComparison.OrdinalIgnoreCase)) return;

        _busy = true;
        _error = null;
        try
        {
            var resp = await Http.PatchAsJsonAsync(
                new Uri(new Uri(Nav.BaseUri), $"api/genealogies/{GenealogyId}/collaborators/{userId}"),
                new UpdateCollaboratorRoleDto(newRole));

            if (!resp.IsSuccessStatusCode)
            {
                _error = await ApiUiMessage.FormatAsync(resp);
                return;
            }

            Toasts.ShowSuccess("角色已更新。");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveCollaboratorAsync(Guid userId)
    {
        if (_busy || !_canManage) return;
        var ok = await JS.InvokeAsync<bool>("confirm", "确定移除此协作者？其将无法再访问本族谱。");
        if (!ok) return;

        _busy = true;
        _error = null;
        try
        {
            var resp = await Http.DeleteAsync(new Uri(new Uri(Nav.BaseUri), $"api/genealogies/{GenealogyId}/collaborators/{userId}"));
            if (!resp.IsSuccessStatusCode)
            {
                _error = await ApiUiMessage.FormatAsync(resp);
                return;
            }

            Toasts.ShowSuccess("已移除协作者。");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class MeMembershipDto
    {
        [System.Text.Json.Serialization.JsonPropertyName("role")]
        public string? Role { get; set; }
    }

    private void BackToGenealogies() => Nav.NavigateTo("/genealogies");
}
