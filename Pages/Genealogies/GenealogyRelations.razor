@page "/genealogies/{GenealogyId:guid}/relations"
@attribute [Authorize]
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@using GenealogyWeb.Controllers
@using GenealogyWeb.Models
@using GenealogyWeb.Shared
@inject HttpClient Http
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>关系查询</PageTitle>

<h3 class="mb-2">关系查询</h3>

<div class="d-flex flex-wrap gap-2 mb-3">
    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="BackToGenealogies">返回族谱列表</button>
    <a class="btn btn-outline-primary btn-sm" href="@($"/genealogies/{GenealogyId}")">族谱设置</a>
    <a class="btn btn-outline-primary btn-sm" href="@($"/genealogies/{GenealogyId}/members")">成员管理</a>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @_error
        <button type="button" class="btn-close" @onclick="() => _error = null" aria-label="关闭"></button>
    </div>
}

@if (!_loaded)
{
    <div class="d-flex align-items-center gap-2 text-muted my-4">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>正在加载成员列表…</span>
    </div>
}
else if (_persons.Count == 0)
{
    <div class="alert alert-light border">本族谱暂无成员，请先在「成员管理」中添加。</div>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title">祖先树</h5>
            <p class="text-muted small mb-3">
                选择一名成员，展示其<strong>父母一代代向上</strong>的缩进树（数据结构上与后代树相反：子列表表示父母）。
            </p>
            <div class="row g-2 align-items-end">
                <div class="col-lg-8">
                    <CompactPersonSearch Label="成员"
                                         Candidates="@_persons"
                                         Query="@_ancestorQuery"
                                         QueryChanged="@SetAncestorQuery"
                                         SelectedId="@_ancestorPersonIdStr"
                                         OnSelect="@SelectAncestorPerson"
                                         OnClear="@ClearAncestorSelection"
                                         IsOpen="@_isAncestorSearchOpen"
                                         IsOpenChanged="@SetAncestorSearchOpen"
                                         Placeholder="输入姓名模糊搜索祖先树成员"
                                         NoMatchesText="没有匹配的成员"
                                         SelectedTextPrefix="当前祖先树成员" />
                </div>
                <div class="col-lg-4">
                    <button type="button" class="btn btn-primary w-100" @onclick="LoadAncestorsAsync" disabled="@_busyAncestors">
                        @if (_busyAncestors)
                        {
                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                        }
                        加载祖先树
                    </button>
                </div>
            </div>

            @if (_ancestorRoots is { Count: > 0 })
            {
                <ul class="list-unstyled mt-3 mb-0">
                    @foreach (var root in _ancestorRoots)
                    {
                        <TreeNodeView Node="root" IsAncestorTree="true" />
                    }
                </ul>
            }
            else if (!_busyAncestors)
            {
                <p class="text-muted small mt-3 mb-0">尚未加载祖先树，请点击「加载祖先树」。</p>
            }
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title">两人亲缘路径</h5>
            <p class="text-muted small mb-3">
                在「父母—子女」与「配偶」构成的无向图上求最短通路；若无通路则表示当前数据下两人不连通。
            </p>
            <div class="row g-2 align-items-end">
                <div class="col-lg-5">
                    <CompactPersonSearch Label="起点"
                                         Candidates="@_persons"
                                         Query="@_kinFromQuery"
                                         QueryChanged="@SetKinFromQuery"
                                         SelectedId="@_kinFromIdStr"
                                         OnSelect="@SelectKinFromPerson"
                                         OnClear="@ClearKinFromSelection"
                                         IsOpen="@_isKinFromSearchOpen"
                                         IsOpenChanged="@SetKinFromSearchOpen"
                                         Placeholder="输入起点姓名"
                                         NoMatchesText="没有匹配的起点成员"
                                         SelectedTextPrefix="当前起点" />
                </div>
                <div class="col-lg-5">
                    <CompactPersonSearch Label="终点"
                                         Candidates="@_persons"
                                         Query="@_kinToQuery"
                                         QueryChanged="@SetKinToQuery"
                                         SelectedId="@_kinToIdStr"
                                         OnSelect="@SelectKinToPerson"
                                         OnClear="@ClearKinToSelection"
                                         IsOpen="@_isKinToSearchOpen"
                                         IsOpenChanged="@SetKinToSearchOpen"
                                         Placeholder="输入终点姓名"
                                         NoMatchesText="没有匹配的终点成员"
                                         SelectedTextPrefix="当前终点" />
                </div>
                <div class="col-lg-2">
                    <button type="button" class="btn btn-outline-primary w-100" @onclick="LoadKinshipAsync" disabled="@_busyKinship">
                        @if (_busyKinship)
                        {
                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                        }
                        查询
                    </button>
                </div>
            </div>

            @if (_kinshipResult != null)
            {
                <div class="mt-3">
                    @if (!_kinshipResult.Connected)
                    {
                        <div class="alert alert-warning mb-0">两人之间<strong>无</strong>亲缘通路（或仅一人存在）。</div>
                    }
                    else if (_kinshipResult.Path is { Count: > 0 })
                    {
                        <div class="border rounded-3 bg-light p-3" style="overflow:auto;">
                            <div class="d-flex align-items-center gap-3" style="white-space:nowrap">
                                @for (var i = 0; i < _kinshipResult.Path.Count; i++)
                                {
                                    var node = _kinshipResult.Path[i];
                                    <div class="p-2 bg-white border rounded text-center" style="min-width:160px;">
                                            <div class="fw-semibold">@node.Name</div>
                                        </div>

                                    if (i < _kinshipResult.Path.Count - 1)
                                    {
                                        var rel = _kinshipResult.Path[i + 1].RelationFromPrevious;
                                        <div class="d-flex flex-column align-items-center text-center" style="min-width:140px;">
                                            <div class="text-muted">→</div>
                                            <div class="badge bg-secondary text-white mt-1">@rel</div>
                                            <div class="text-muted">→</div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border mb-0 small">已连通但未解析到路径节点，请重试或联系管理员。</div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public Guid GenealogyId { get; set; }

    private List<Person> _persons = new();
    private bool _loaded;
    private string? _error;

    private string _ancestorPersonIdStr = "";
    private string _ancestorQuery = "";
    private List<TreeNodeDto>? _ancestorRoots;
    private bool _busyAncestors;
    private bool _isAncestorSearchOpen;

    private string _kinFromIdStr = "";
    private string _kinFromQuery = "";
    private string _kinToIdStr = "";
    private string _kinToQuery = "";
    private KinshipPathClientDto? _kinshipResult;
    private bool _busyKinship;
    private bool _isKinFromSearchOpen;
    private bool _isKinToSearchOpen;

    protected override async Task OnParametersSetAsync()
    {
        _error = null;
        _ancestorRoots = null;
        _kinshipResult = null;
        _loaded = false;
        await LoadPersonsAsync();
    }

    private async Task LoadPersonsAsync()
    {
        try
        {
            var baseUri = new Uri(Nav.BaseUri);
            var resp = await Http.GetAsync(new Uri(baseUri, $"api/persons/byGenealogy/{GenealogyId}"));
            if (!resp.IsSuccessStatusCode)
            {
                _error = await ApiUiMessage.FormatAsync(resp);
                _persons = new List<Person>();
                _loaded = true;
                return;
            }

            _persons = await resp.Content.ReadFromJsonAsync<List<Person>>(ApiUiMessage.JsonReadOptions) ?? new List<Person>();
            if (_persons.Count > 0)
            {
                var first = _persons[0].Id.ToString();
                if (string.IsNullOrEmpty(_ancestorPersonIdStr) || _persons.All(p => p.Id.ToString() != _ancestorPersonIdStr))
                {
                    _ancestorPersonIdStr = first;
                    _ancestorQuery = _persons[0].GivenName;
                }
                else if (string.IsNullOrWhiteSpace(_ancestorQuery) && Guid.TryParse(_ancestorPersonIdStr, out var ancestorId))
                {
                    _ancestorQuery = _persons.FirstOrDefault(p => p.Id == ancestorId)?.GivenName ?? _ancestorQuery;
                }

                if (string.IsNullOrEmpty(_kinFromIdStr) || _persons.All(p => p.Id.ToString() != _kinFromIdStr))
                {
                    _kinFromIdStr = first;
                    _kinFromQuery = _persons[0].GivenName;
                }
                else if (string.IsNullOrWhiteSpace(_kinFromQuery) && Guid.TryParse(_kinFromIdStr, out var fromId))
                {
                    _kinFromQuery = _persons.FirstOrDefault(p => p.Id == fromId)?.GivenName ?? _kinFromQuery;
                }

                if (string.IsNullOrEmpty(_kinToIdStr) || _persons.All(p => p.Id.ToString() != _kinToIdStr))
                {
                    var second = _persons.Count > 1 ? _persons[1].Id.ToString() : first;
                    _kinToIdStr = second;
                    _kinToQuery = _persons.Count > 1 ? _persons[1].GivenName : _persons[0].GivenName;
                }
                else if (string.IsNullOrWhiteSpace(_kinToQuery) && Guid.TryParse(_kinToIdStr, out var toId))
                {
                    _kinToQuery = _persons.FirstOrDefault(p => p.Id == toId)?.GivenName ?? _kinToQuery;
                }
            }

            _loaded = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _loaded = true;
        }
    }

    private async Task LoadAncestorsAsync()
    {
        if (!Guid.TryParse(_ancestorPersonIdStr, out var pid))
        {
            Toasts.ShowInfo("请选择成员。");
            return;
        }

        _busyAncestors = true;
        _error = null;
        try
        {
            var baseUri = new Uri(Nav.BaseUri);
            var url = new Uri(baseUri, $"api/genealogies/{GenealogyId}/ancestors?personId={pid}");
            var resp = await Http.GetAsync(url);
            if (!resp.IsSuccessStatusCode)
            {
                _error = await ApiUiMessage.FormatAsync(resp);
                _ancestorRoots = null;
                return;
            }

            _ancestorRoots = await resp.Content.ReadFromJsonAsync<List<TreeNodeDto>>(ApiUiMessage.JsonReadOptions) ?? new List<TreeNodeDto>();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _ancestorRoots = null;
        }
        finally
        {
            _busyAncestors = false;
        }
    }

    private void SetAncestorQuery(string value) => _ancestorQuery = value;
    private void SetAncestorSearchOpen(bool isOpen) => _isAncestorSearchOpen = isOpen;

    private Task SelectAncestorPerson(Person person)
    {
        _ancestorPersonIdStr = person.Id.ToString();
        _ancestorQuery = person.GivenName;
        _isAncestorSearchOpen = true;
        return Task.CompletedTask;
    }

    private Task ClearAncestorSelection()
    {
        _ancestorPersonIdStr = string.Empty;
        _ancestorQuery = string.Empty;
        return Task.CompletedTask;
    }

    private void SetKinFromQuery(string value) => _kinFromQuery = value;
    private void SetKinFromSearchOpen(bool isOpen) => _isKinFromSearchOpen = isOpen;

    private Task SelectKinFromPerson(Person person)
    {
        _kinFromIdStr = person.Id.ToString();
        _kinFromQuery = person.GivenName;
        _isKinFromSearchOpen = true;
        return Task.CompletedTask;
    }

    private Task ClearKinFromSelection()
    {
        _kinFromIdStr = string.Empty;
        _kinFromQuery = string.Empty;
        return Task.CompletedTask;
    }

    private void SetKinToQuery(string value) => _kinToQuery = value;
    private void SetKinToSearchOpen(bool isOpen) => _isKinToSearchOpen = isOpen;

    private Task SelectKinToPerson(Person person)
    {
        _kinToIdStr = person.Id.ToString();
        _kinToQuery = person.GivenName;
        _isKinToSearchOpen = true;
        return Task.CompletedTask;
    }

    private Task ClearKinToSelection()
    {
        _kinToIdStr = string.Empty;
        _kinToQuery = string.Empty;
        return Task.CompletedTask;
    }

    private async Task LoadKinshipAsync()
    {
        if (!Guid.TryParse(_kinFromIdStr, out var fromId) || !Guid.TryParse(_kinToIdStr, out var toId))
        {
            Toasts.ShowInfo("请选择起点与终点。");
            return;
        }

        _busyKinship = true;
        _error = null;
        try
        {
            var baseUri = new Uri(Nav.BaseUri);
            var url = new Uri(baseUri, $"api/genealogies/{GenealogyId}/kinship?fromPersonId={fromId}&toPersonId={toId}");
            var resp = await Http.GetAsync(url);
            if (!resp.IsSuccessStatusCode)
            {
                _error = await ApiUiMessage.FormatAsync(resp);
                _kinshipResult = null;
                return;
            }

            _kinshipResult = await resp.Content.ReadFromJsonAsync<KinshipPathClientDto>(ApiUiMessage.JsonReadOptions);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _kinshipResult = null;
        }
        finally
        {
            _busyKinship = false;
        }
    }

    private sealed class KinshipPathClientDto
    {
        [JsonPropertyName("connected")]
        public bool Connected { get; set; }

        [JsonPropertyName("path")]
        public List<KinshipStepClientDto>? Path { get; set; }
    }

    private sealed class KinshipStepClientDto
    {
        [JsonPropertyName("personId")]
        public Guid PersonId { get; set; }

        [JsonPropertyName("name")]
        public string Name { get; set; } = "";

        [JsonPropertyName("relationFromPrevious")]
        public string RelationFromPrevious { get; set; } = "";
    }

    private void BackToGenealogies() => Nav.NavigateTo("/genealogies");
}
