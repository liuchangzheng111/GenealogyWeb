@*
    注册页：逻辑同 Login，调用 POST /api/auth/register。
*@
@page "/register"
@using Microsoft.AspNetCore.WebUtilities
@using GenealogyWeb.Shared
@inject NavigationManager Nav

<PageTitle>注册</PageTitle>

<div class="row justify-content-center">
    <div class="col-12 col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h3 class="card-title mb-3">注册</h3>
                <p class="text-muted small mb-3">
                    已有账号？<a href="@LoginHref">去登录</a>
                    ·
                    <a href="/">返回首页</a>
                </p>
                <div class="mb-3">
                    <label for="register-userName" class="form-label">用户名</label>
                    <input id="register-userName" class="form-control" autocomplete="nickname" />
                </div>
                <div class="mb-3">
                    <label for="register-email" class="form-label">邮箱</label>
                    <input id="register-email" class="form-control" type="email" autocomplete="email" />
                </div>
                <div class="mb-3">
                    <label for="register-password" class="form-label">密码</label>
                    <input id="register-password" class="form-control" type="password" autocomplete="new-password" />
                    <div class="form-text">请使用足够强度的密码（课程演示环境请勿与真实密码相同）。</div>
                </div>
                <button type="button" class="btn btn-primary w-100" onclick="registerSubmit()">注册</button>
                <div id="register-message" class="mt-3" style="display:none"></div>
            </div>
        </div>
    </div>
</div>

@code {
    private string? _returnUrlFromQuery;

    private string LoginHref
    {
        get
        {
            if (ReturnUrlHelper.IsSafeLocalPath(_returnUrlFromQuery))
            {
                return "/login?returnUrl=" + Uri.EscapeDataString(_returnUrlFromQuery!);
            }

            return "/login";
        }
    }

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("returnUrl", out var v))
        {
            var raw = v.ToString();
            if (ReturnUrlHelper.IsSafeLocalPath(raw))
            {
                _returnUrlFromQuery = raw;
            }
        }
    }
}
