@*
    注册页：逻辑同 Login，调用 POST /api/auth/register。
*@
@page "/register"
<h3>注册</h3>

<div class="mb-3">
    <label>用户名</label>
    <input id="register-userName" class="form-control" />
</div>
<div class="mb-3">
    <label>邮箱</label>
    <input id="register-email" class="form-control" />
</div>
<div class="mb-3">
    <label>密码</label>
    <input id="register-password" type="password" class="form-control" />
</div>
<button type="button" class="btn btn-primary" onclick="registerSubmit()">注册</button>

<div id="register-message" class="mt-2" style="display:none"></div>
