@page "/login"
<h3>登录</h3>

<div class="mb-3">
    <label>邮箱</label>
    <input id="login-email" class="form-control" />
</div>
<div class="mb-3">
    <label>密码</label>
    <input id="login-password" type="password" class="form-control" />
</div>
<button type="button" class="btn btn-primary" onclick="loginSubmit()">登录</button>

<div id="login-message" class="mt-2" style="display:none"></div>
