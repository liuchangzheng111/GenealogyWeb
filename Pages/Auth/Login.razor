@*
    登录页：表单由原生 input + wwwroot/js/auth.js 提交 POST /api/auth/login（含 credentials 以写入 Cookie）。
*@
@page "/login"
@using Microsoft.AspNetCore.WebUtilities
@using GenealogyWeb.Shared
@inject NavigationManager Nav

<PageTitle>登录</PageTitle>
    <div class="col-12 col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h3 class="card-title mb-3">登录</h3>
                <p class="text-muted small mb-3">
                    还没有账号？<a href="@RegisterHref">去注册</a>
                    ·
                    <a href="/">返回首页</a>
                </p>
                <div class="alert alert-light border small mb-3" role="note">
                    演示账号：<code>demo@genealogy.local</code> / <code>Demo123!</code>
                </div>
                <input type="hidden" id="login-returnUrl" value="@EffectiveReturnUrl" />
                <div class="mb-3">
                    <label for="login-email" class="form-label">邮箱</label>
                    <input id="login-email" class="form-control" type="email" autocomplete="username" placeholder="you@example.com" />
                </div>
                <div class="mb-3">
                    <label for="login-password" class="form-label">密码</label>
                    <input id="login-password" class="form-control" type="password" autocomplete="current-password" />
                </div>
                <button type="button" class="btn btn-primary w-100" onclick="loginSubmit()">登录</button>
                <div id="login-message" class="mt-3" style="display:none"></div>
            </div>
        </div>
    </div>


@code {
    private string? _returnUrlFromQuery;

    private string EffectiveReturnUrl =>
        ReturnUrlHelper.IsSafeLocalPath(_returnUrlFromQuery) ? _returnUrlFromQuery! : "/";

    private string RegisterHref
    {
        get
        {
            if (ReturnUrlHelper.IsSafeLocalPath(_returnUrlFromQuery))
            {
                return "/register?returnUrl=" + Uri.EscapeDataString(_returnUrlFromQuery!);
            }

            return "/register";
        }
    }

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("returnUrl", out var v))
        {
            var raw = v.ToString();
            if (ReturnUrlHelper.IsSafeLocalPath(raw))
            {
                _returnUrlFromQuery = raw;
            }
        }
    }
}
