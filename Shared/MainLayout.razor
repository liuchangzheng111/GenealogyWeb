@*
    全局布局：顶栏根据 AuthorizeView 切换登录/注册与用户名、退出链接。
    退出使用 GET /logout（浏览器请求），以便清除认证 Cookie；详见 Program.cs 注释。
*@
@namespace GenealogyWeb
@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <nav class="navbar navbar-expand-lg navbar-light bg-light">
                <a class="navbar-brand" href="/">GenealogyWeb</a>
                <AuthorizeView>
                    <Authorized>
                        <a class="nav-link d-inline-block me-3" href="/genealogies">族谱管理</a>
                    </Authorized>
                </AuthorizeView>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <AuthorizeView>
                        <Authorized Context="auth">
                            <span class="navbar-text me-2">@auth.User.Identity?.Name</span>
                            <a class="btn btn-outline-secondary" href="/logout">退出</a>
                        </Authorized>
                        <NotAuthorized>
                            <a class="btn btn-outline-primary" href="/login">登录</a>
                            <a class="btn btn-outline-secondary" href="/register">注册</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </nav>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-12">
            @Body
        </div>
    </div>
</div>
