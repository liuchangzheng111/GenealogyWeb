@using GenealogyWeb.Models

<div class="border rounded p-2 bg-light" style="min-height: 4.5rem;">
    <div class="d-flex justify-content-between align-items-center gap-2">
        <strong>@Label</strong>
        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ToggleOpenAsync">
            @(IsOpen ? "收起" : "展开搜索")
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(SelectedId) && TryGetSelectedPerson(out var selectedPerson) && selectedPerson is not null)
    {
        <div class="text-muted small mt-1">@SelectedTextPrefix：@FormatPersonLabel(selectedPerson)</div>
    }

    @if (IsOpen)
    {
        <div class="mt-2">
            <input class="form-control" placeholder="@Placeholder" value="@Query" @oninput="OnQueryInputAsync" />

            @if (!string.IsNullOrWhiteSpace(Query) && !GetMatches().Any())
            {
                <div class="text-muted small mt-2">@NoMatchesText</div>
            }

            @if (!string.IsNullOrWhiteSpace(SelectedId) && TryGetSelectedPerson(out var selectedAgain) && selectedAgain is not null)
            {
                <div class="d-flex align-items-center gap-2 mt-2 mb-2">
                    <span class="badge bg-success">已选：@FormatPersonLabel(selectedAgain)</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearAsync">清空</button>
                </div>
            }

            @if (GetMatches() is { Count: > 0 } matches)
            {
                <div class="list-group mb-2">
                    @foreach (var person in matches.Take(MaxResults))
                    {
                        <button type="button"
                                class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                @onclick="() => SelectAsync(person)">
                            @FormatPersonLabel(person)
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public IEnumerable<Person> Candidates { get; set; } = Array.Empty<Person>();
    [Parameter] public string Query { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> QueryChanged { get; set; }
    [Parameter] public string SelectedId { get; set; } = string.Empty;
    [Parameter] public EventCallback<Person> OnSelect { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "输入姓名模糊搜索";
    [Parameter] public string NoMatchesText { get; set; } = "没有匹配成员";
    [Parameter] public string SelectedTextPrefix { get; set; } = "已选择";
    [Parameter] public int MaxResults { get; set; } = 8;

    private Task ToggleOpenAsync() => IsOpenChanged.InvokeAsync(!IsOpen);

    private Task OnQueryInputAsync(ChangeEventArgs e)
        => QueryChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);

    private Task SelectAsync(Person person)
        => OnSelect.InvokeAsync(person);

    private Task ClearAsync()
        => OnClear.InvokeAsync();

    private List<Person> GetMatches()
    {
        var list = Candidates.Where(p => p is not null).ToList();

        if (string.IsNullOrWhiteSpace(Query))
        {
            return list;
        }

        var trimmed = Query.Trim();
        return list
            .Where(p => p.GivenName.Contains(trimmed, StringComparison.OrdinalIgnoreCase))
            .OrderBy(p => p.BirthYear ?? int.MaxValue)
            .ThenBy(p => p.GivenName)
            .ToList();
    }

    private bool TryGetSelectedPerson(out Person? person)
    {
        person = null;
        if (!Guid.TryParse(SelectedId, out var selectedId))
        {
            return false;
        }

        person = Candidates.FirstOrDefault(p => p.Id == selectedId);
        return person != null;
    }

    private static string FormatPersonLabel(Person person)
    {
        var life = person.BirthYear.HasValue || person.DeathYear.HasValue
            ? $" ({person.BirthYear?.ToString() ?? "?"}—{person.DeathYear?.ToString() ?? "?"})"
            : string.Empty;

        return $"{person.GivenName}{life}";
    }
}